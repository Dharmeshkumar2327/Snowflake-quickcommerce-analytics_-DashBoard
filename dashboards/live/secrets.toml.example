# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# NEVER commit the real file. .gitignore already ignores .streamlit/secrets.toml
[connections.snowflake]
account   = "xy12345.ap-south-1.aws"
user      = "DASHBOARD_READER"
password  = "********"            # or use key-pair: private_key_file = "rsa_key.p8"
role      = "DASHCART_ANALYST"    # masked PII, row access policy applies (sql/07)
warehouse = "DASHCART_BI_WH"
database  = "DASHCART"
schema    = "MARTS"
client_session_keep_alive = true
