<?xml version='1.0'?>
<!-- Copy into  Documents\My Tableau Repository\Preferences.tps  (merge if one exists), then restart Tableau.
     Palettes appear under Edit Colors -> Select Color Palette. -->
<workbook>
  <preferences>
    <color-palette name="DashCart Cities" type="regular">
      <color>#2a78d6</color>  <!-- Bengaluru -->
      <color>#eb6834</color>  <!-- Chennai -->
      <color>#1baf7a</color>  <!-- Delhi -->
      <color>#eda100</color>  <!-- Hyderabad -->
      <color>#e87ba4</color>  <!-- Mumbai -->
      <color>#008300</color>  <!-- Pune -->
      <color>#6250d6</color>
      <color>#e34948</color>
    </color-palette>
    <color-palette name="DashCart Sequential Blue" type="ordered-sequential">
      <color>#cde2fb</color>
      <color>#86b6ef</color>
      <color>#3987e5</color>
      <color>#256abf</color>
      <color>#184f95</color>
      <color>#104281</color>
    </color-palette>
    <color-palette name="DashCart SLA Diverging" type="ordered-diverging">
      <color>#d03b3b</color>
      <color>#e88a86</color>
      <color>#f0efec</color>
      <color>#86b6ef</color>
      <color>#2a78d6</color>
    </color-palette>
    <color-palette name="DashCart Status" type="regular">
      <color>#0ca30c</color>  <!-- good -->
      <color>#fab219</color>  <!-- warning -->
      <color>#ec835a</color>  <!-- serious -->
      <color>#d03b3b</color>  <!-- critical -->
    </color-palette>
  </preferences>
</workbook>
